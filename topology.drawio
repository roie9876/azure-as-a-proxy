        </mxCell>
        <mxCell id="legendContent" value="━━ blue:  user / data plane (HTTPS, WSS to /websockify, TLS sandbox→SaaS)&#xa;┄┄ dashed:  control / metadata (OIDC, DNS, KV access, ARM)&#xa;Orange:  per-browser RBI sandbox (Azure Container Instance, custom kiosk image)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#424242;spacingLeft=14;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="932" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Cloaks: URL · DNS · cert · DOM · cookies · response body · server/x-powered-by/x-nextjs-* headers · etag · cert-error interstitial · network capture · browser memory      NOT cloaked: rendered SaaS pixels (branding visible)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#7A5A00;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="930" width="960" height="40" as="geometry" />
