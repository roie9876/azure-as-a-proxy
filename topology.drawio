        <mxCell id="title" value="Path A — Hide Network Identity of an Unknown SaaS (RBI on Azure PaaS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
